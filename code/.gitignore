# Per-message traces: ~264 MB of regenerable simulation output.
# Recreate with the trace section of run_experiments.sh.
traces/

# Bulk simulation intermediates: per-reception traces and per-pair tables.
# Regenerable from the retained plan/manifest, and several GB in total --- well
# past GitHub's 100 MB per-file limit. Version-agnostic on purpose: the earlier
# v3/v4-specific rules silently stopped matching when the schema was bumped to
# v5 and then v6, and 7 GB of raw output was committed as a result.
# Compact summaries, manifests and analysis tables stay tracked.
results/*/*/runs/
results/*/*/pairs_v*.csv
results/*/*/validation_pairs_v*.csv
results/*/smoke/
results/*/archive/

# Generated by test/mkharness.py at build time -- never edit, never commit.
test/core.inc
test/test_detector

# Transient
sweep.log
.sweep_jobs
*.o
__pycache__/

# Rendered figures are build products of make_methodology_figure.py
figures/*.png
results/noiseshape/*.csv
results/veremi/*/trace.csv

# local virtualenv (recreate with: python3 -m venv .venv)
.venv/
